<FindBugsFilter>
    <!-- The model is built almost entirely from java.util records whose List components are already
         populated with an immutable copy (List.copyOf/List.of) at construction; the canonical accessor
         SpotBugs is objecting to never lets a caller reach the mutable backing list. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP, EI_EXPOSE_REP2" />
    </Match>

    <Match>
        <Class name="io.ballerina.tools.discover.cli.DiscoverTool" />
        <Method name="execute" />
        <Bug pattern="DM_EXIT" />
    </Match>

    <!-- picocli sets these reflectively when the help flag is passed; the field is never read from our
         own code, only inspected by picocli itself. -->
    <Match>
        <Field name="help" />
        <Bug pattern="URF_UNREAD_FIELD" />
    </Match>

    <!-- NONE is a shared constant for "no return type", not an enforced singleton: FromCentral still
         constructs real ReturnDef values through the same constructor for actual return types. -->
    <Match>
        <Class name="io.ballerina.tools.discover.model.ReturnDef" />
        <Bug pattern="SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR" />
    </Match>
</FindBugsFilter>
